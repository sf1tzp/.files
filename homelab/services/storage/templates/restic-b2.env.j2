# Managed by homelab/services/storage (sf1tzp/.files).
# B2 via the S3-compatible endpoint, same shape as the estate's restic
# targets (deployments docs/infra/backups.md): one repo per host under
# its own prefix. The bucket is the hub's own (sfi-hub-pv-backups), not
# the forts' sfi-pv-backups — a different retention domain is a
# different bucket.
RESTIC_REPOSITORY=s3:https://s3.us-west-004.backblazeb2.com/sfi-hub-pv-backups/soundship
RESTIC_PASSWORD_FILE=/etc/restic/storage.pass
AWS_ACCESS_KEY_ID={{ storage_b2_key_id }}
AWS_SECRET_ACCESS_KEY={{ storage_b2_app_key }}
