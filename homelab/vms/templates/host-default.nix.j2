# {{ item.hostname }} — single-node k3s VM on Soundship (libvirt/KVM).
#
# GENERATED by homelab/vms/create-nixos.yaml from templates/host-default.nix.j2,
# driven by the host's entry in homelab/inventory.yaml. The playbook only writes
# this file when it is ABSENT (force: no), so any hand-edits you make afterwards
# survive re-runs — inventory seeds the host, you refine it here.
#
# Built as a qcow2 via nixos-generators — the flake auto-discovers this dir and
# exposes it as `{{ item.hostname }}-qcow`. The root filesystem and bootloader
# come from the qcow format, so there is no hand-written hardware.nix. Reachable
# as `steven` over SSH (keys from common.nix).
{ modulesPath, ... }:

{
  imports = [
    # virtio drivers for the KVM guest; harmless if the format already adds them.
    (modulesPath + "/profiles/qemu-guest.nix")
    # Role modules — the host dir is self-describing so the flake stays uniform
    # and needs no per-host edit when a new host is added via inventory.
    ./secrets.nix
    ../../modules/k3s-server.nix
{% if item.wg_vpn_ip is defined %}
    ../../modules/wireguard.nix    # mesh member (wg_vpn_ip set in inventory)
{% endif %}
    ../../modules/dotfiles.nix     # clone ~/.files from the internal gitea over
                                   # TLS (lab CA trusted via k3s-server.nix)
  ];

  networking.hostName = "{{ item.hostname }}";

  # Static address on Soundship's LAN bridge — matches ansible_host in
  # homelab/inventory.yaml.
  networking.useDHCP = false;
  systemd.network.enable = true;
  systemd.network.networks."10-lan" = {
    matchConfig.Name = "en*";
    address = [ "{{ item.ip }}/{{ item.lan_prefix }}" ];
    gateway = [ "{{ item.lan_gateway }}" ];
    dns = [ {% for d in item.lan_dns %}"{{ d }}"{{ " " if not loop.last }}{% endfor %} ];
  };

  # Single-node server with embedded etcd (server config and the k3s-token
  # requirement come from modules/k3s-server.nix). Set to false in inventory
  # (k3s_cluster_init: false) for a lean sqlite datastore instead.
  services.k3s.clusterInit = {{ "true" if item.cluster_init else "false" }};

  # sops wiring is in ./secrets.nix: it points defaultSopsFile at
  # secrets/{{ item.hostname }}.yaml and decrypts via the pre-seeded SSH host key
  # (age.sshKeyPaths) that create-nixos.yaml injects into the qcow2 before first
  # boot. Secrets are split per-host, so this host only declares the keys it
  # actually carries — no declared-but-absent secrets to fail activation.

  system.stateVersion = "{{ item.state_version }}";
}
