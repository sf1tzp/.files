<domain type='kvm'>
  <name>{{ item.hostname }}</name>
  <memory unit='MiB'>{{ item.memory * 1024 }}</memory>
  <vcpu>{{ item.vcpus }}</vcpu>
  <os>
    <type arch='x86_64'>hvm</type>
    <boot dev='hd'/>
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  <cpu mode='host-passthrough'/>
  <devices>
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source file='/var/lib/libvirt/images/{{ item.hostname }}.qcow2'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    <!-- No cloud-init cdrom: the NixOS image is fully configured at build time. -->
    <interface type='bridge'>
      <source bridge='br0'/>
      <model type='virtio'/>
    </interface>
    <!-- Serial console so `virsh console {{ item.hostname }}` works. -->
    <serial type='pty'/>
    <console type='pty'/>
    <graphics type='vnc' port='-1' autoport='yes' listen='127.0.0.1'/>
    <video>
      <model type='cirrus'/>
    </video>
  </devices>
</domain>
