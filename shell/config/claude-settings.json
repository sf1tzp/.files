{
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "SFI_AGENT": "1",
    "GIT_AUTHOR_NAME": "sfi-agent",
    "GIT_AUTHOR_EMAIL": "support@streetfortress.com",
    "GIT_COMMITTER_NAME": "sfi-agent",
    "GIT_COMMITTER_EMAIL": "support@streetfortress.com",
    "GIT_CONFIG_COUNT": "3",
    "GIT_CONFIG_KEY_0": "user.signingkey",
    "GIT_CONFIG_VALUE_0": "=sfi-agent <support@streetfortress.com>",
    "GIT_CONFIG_KEY_1": "commit.gpgsign",
    "GIT_CONFIG_VALUE_1": "true",
    "GIT_CONFIG_KEY_2": "tag.gpgsign",
    "GIT_CONFIG_VALUE_2": "true"
  },
  "includeCoAuthoredBy": false,
  "model": "claude-fable-5[1m]",
  "effortLevel": "high",
  "theme": "dark",
  "tui": "fullscreen",
  "awaySummaryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": false,
  "switchModelsOnFlag": false,
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(tea issues create*)",
      "Bash(tea issues edit*)",
      "Bash(tea issues close*)",
      "Bash(tea issues reopen*)",
      "Bash(tea comment*)",
      "Bash(tea pr create*)",
      "Bash(tea pr edit*)",
      "Bash(tea labels*)",
      "Bash(tea milestones*)"
    ],
    "ask": [
      "Bash(tea pr approve*)",
      "Bash(tea pr merge*)",
      "Bash(gh pr create*)",
      "Bash(gh release*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(ssh sfi-prod*)",
      "Bash(ssh 10.1.0.54*)"
    ],
    "deny": [
      "Read(/etc/wireguard/**)",
      "Edit(/etc/wireguard/**)",
      "Bash(cat /etc/wireguard/*)",
      "Bash(sudo cat /etc/wireguard/*)"
    ]
  },
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Publish steps on public/external services: PRs, issues, or releases on github.com, package registry pushes \u2014 Steven vets content before anything publishes",
      "Force-pushes or history rewrites on shared branches (main, or any branch with an open PR)",
      "SSH or remote command execution on the production fort \u2014 sfi-prod-439bf72 or any sfi-prod-* host, mesh IP 10.1.0.54 \u2014 in any spelling (hostname, IP, ssh alias, ansible limit, sfi-* ops verb), including read-only checks; read its state through the ops-ro kubeconfig context or central monitoring instead",
      "Reading, printing, or editing rendered WireGuard configs or key material (/etc/wireguard/*, PrivateKey values, wg genkey output) by any means \u2014 cat, grep, sed, tee, redirection, sudo; change the Ansible template and re-run the playbook instead"
    ]
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.claude/hooks/herdr-agent-state.sh\" ] && bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
