{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "includeCoAuthoredBy": false,
  "model": "claude-fable-5[1m]",
  "effortLevel": "high",
  "theme": "dark",
  "tui": "fullscreen",
  "awaySummaryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": false,
  "permissions": {
    "defaultMode": "auto",
    "ask": [
      "Bash(gh pr create*)",
      "Bash(gh release*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Publish steps on public/external services: PRs, issues, or releases on github.com, package registry pushes — Steven vets content before anything publishes",
      "Force-pushes or history rewrites on shared branches (main, or any branch with an open PR)"
    ]
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.claude/hooks/herdr-agent-state.sh\" ] && bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
