#!/usr/bin/env zsh
#
# shellcheck disable=SC1071

setopt IGNORE_EOF # disable ctrl+d 

alias reload="source $HOME/.zshrc"

# Init Shell Completions
autoload -Uz compinit && compinit

# Local bins
if [ -d "$HOME/.local/bin" ]; then
    export PATH="$HOME/.local/bin:$PATH"
fi

# Local bins
if [ -f "$HOME/.local/bin/env" ]; then
    source "$HOME/.local/bin/env"
fi

# Cargo env
if [[ -f "$HOME/.cargo/env" ]]; then
    source "$HOME/.cargo/env"
fi

# Go Path
if [[ -d /usr/local/go/bin/ ]]; then
    export PATH=$PATH:/usr/local/go/bin
    export PATH="$PATH:$HOME/go/bin"
fi

if [[ -d ~/go/bin/ ]]; then
    export PATH=$PATH:/go/bin
fi

# if [[ -d .venv ]]; then
#     source .venv/bin/activate
# fi

# Check for / install utilities (skip on NixOS, packages managed by Nix)
if [[ "$(uname -s)" == "Linux" && ! -f /etc/NIXOS ]]; then
    "$HOME/.files/shell/scripts/install.py"
fi

# Fnm (Nodejs Version Manager)
if which fnm &>/dev/null; then
    eval "$(fnm completions --shell zsh)"
    eval "$(fnm env --use-on-cd --shell zsh)"
    if [[ $(fnm list | wc -l) == 1 ]]; then
        fnm install 23
    fi
fi

# Homebrew env
if [[ -f /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
    export ZPLUG_HOME="/opt/homebrew/opt/zplug"
    if [[ -d /opt/homebrew/opt/tpm/share/tpm && ! -d ~/.tmux/plugins/tpm ]]; then
        mkdir -p ~/.tmux/plugins
        ln -s /opt/homebrew/opt/tpm/share/tpm ~/.tmux/plugins/tpm
    fi
fi

# Alacritty Config
if [ ! -f ~/.config/alacritty/alacritty.toml ]; then
	mkdir -p ~/.config/alacritty
	ln -s ~/.files/shell/config/alacritty.toml ~/.config/alacritty/alacritty.toml
fi

# Sync Alacritty theme with the OS appearance (alacritty-theme-switch).
# Runs per shell startup; Alacritty live-reloads its config, so opening a
# new terminal after an OS light/dark switch updates all open windows.
_alacritty_sync_os_theme() {
    local light="everforest_light.toml" dark="everforest_dark.toml" desired=""
    case "$(uname -s)" in
    Darwin)
        if defaults read -g AppleInterfaceStyle &>/dev/null; then
            desired=$dark
        else
            desired=$light
        fi
        ;;
    Linux)
        if which gsettings &>/dev/null; then
            case "$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)" in
            *dark*) desired=$dark ;;
            *) desired=$light ;;
            esac
        fi
        ;;
    esac
    [[ -z "$desired" ]] && return
    # ats rewrites the config on every run; skip if already active
    grep -q "themes/$desired" ~/.config/alacritty/alacritty.toml 2>/dev/null && return
    ats --select "$desired" &>/dev/null
}
if which ats &>/dev/null; then
    _alacritty_sync_os_theme &!
fi


# Just
if which just &>/dev/null; then
    eval "$(just --completions=zsh)"
fi

# Neovim
if [[ -d /usr/local/nvim/bin ]]; then
    export EDITOR=nvim
    export PATH="${PATH:+${PATH}:}/usr/local/nvim/bin"
fi

# Starship
if which starship &>/dev/null; then
    # workaround a starship bug on MacOS https://github.com/starship/starship/issues/3418#issuecomment-2477375663
    if [[ "${widgets[zle - keymap - select]#user:}" == "starship_zle-keymap-select" ||
        "${widgets[zle - keymap - select]#user:}" == "starship_zle-keymap-select-wrapped" ]]; then
        zle -N zle-keymap-select ""
    fi
    eval "$(starship init zsh)"

    if [[ ! -f "$HOME/.config/starship.toml" ]]; then
        ln -s "$HOME/.files/shell/config/starship.toml" "$HOME/.config/starship.toml"
    fi
fi

# Herdr
if which herdr &>/dev/null; then
    if [[ ! -f "$HOME/.config/herdr/config.toml" ]]; then
        mkdir -p "$HOME/.config/herdr"
        ln -s "$HOME/.files/shell/config/herdr.toml" "$HOME/.config/herdr/config.toml"
    fi
fi

# Claude Code global instructions (home-manager manages this on NixOS)
if [[ ! -f "$HOME/.claude/CLAUDE.md" && -f "$HOME/.files/shell/config/CLAUDE.md" ]]; then
    mkdir -p "$HOME/.claude"
    ln -s "$HOME/.files/shell/config/CLAUDE.md" "$HOME/.claude/CLAUDE.md"
fi

# Claude Code personal skills (home-manager manages this on NixOS)
if [[ ! -e "$HOME/.claude/skills" && -d "$HOME/.files/shell/config/claude-skills" ]]; then
    mkdir -p "$HOME/.claude"
    ln -s "$HOME/.files/shell/config/claude-skills" "$HOME/.claude/skills"
fi

# Claude Code shared settings — merged, not symlinked (Claude Code's atomic
# writes replace symlinks; see the sync script). All hosts, NixOS included:
# the target must stay a writable regular file.
if [[ -x "$HOME/.files/shell/scripts/claude-settings-sync.sh" ]]; then
    "$HOME/.files/shell/scripts/claude-settings-sync.sh"
fi

# Updating Clock
TMOUT=1
TRAPALRM() {
    case "$WIDGET" in
    *fzf* | expand-or-complete | self-insert | up-line-or-beginning-search | down-line-or-beginning-search | backward-delete-char | .history-incremental-search-backward | .history-incremental-search-forward)
        :
        ;;

    *)
        zle reset-prompt
        ;;
    esac
}

# Fzf (note: initialized in zplug, after zsh-vi-mode)
if [[ -f "$HOME/.fzf/bin/fzf" ]]; then
    export PATH="$PATH:/$HOME/.fzf/bin"
fi
export FZF_ALT_C_COMMAND=""
export FZF_CTRL_T_COMMAND=""

# Set up fzf zsh plugins (NixOS uses home-manager plugins; non-NixOS uses zplug)
if [[ ! -f /etc/NIXOS ]]; then
    source ~/.files/shell/zsh/zplug
else
    # fzf init after zsh-vi-mode (loaded by home-manager)
    zvm_after_init_commands+=('source <(fzf --zsh)')
fi

# Override fzf Ctrl-R to start with empty query instead of current buffer contents
zvm_after_init_commands+=('
  _fzf_history_empty_query() {
    local orig=$LBUFFER
    LBUFFER=""
    zle fzf-history-widget
    [[ -z $LBUFFER ]] && LBUFFER=$orig
  }
  zle -N _fzf_history_empty_query
  bindkey "^R" _fzf_history_empty_query
')

if which kubectl &>/dev/null; then
    export KUBECONFIG=~/.kube/config$(fd -t f --glob '*.config' ~/.kube | sed 's/^/:/' | tr -d '\n')
    source "$HOME/.files/shell/k8s/k8s.sh"
fi

if which sops &>/dev/null; then
  source <(sops completion zsh)
fi

# aliases and command specific stuff
source "$HOME/.files/shell/aliases"
source "$HOME/.files/shell/zsh/history"
source "$HOME/.files/shell/scripts/download.sh"
source "$HOME/.files/shell/scripts/worktrees.sh"

# zoxide wants to be at the end
if which zoxide &>/dev/null; then
    # Don't init zoxide for claude code
    if [[ "$CLAUDECODE" != "1" ]]; then
      eval "$(zoxide init --cmd cd zsh)"
    fi
fi

if [ -e /home/steven/.nix-profile/etc/profile.d/nix.sh ]; then . /home/steven/.nix-profile/etc/profile.d/nix.sh; fi # added by Nix installer
