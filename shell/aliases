# command specific aliases
if which alacritty &>/dev/null && which fzf &>/dev/null; then
	# Pick a theme for the current alacritty window only, live-previewing as
	# you scroll. Applied over IPC (alacritty msg config), so the global config
	# and the OS-synced theme (_alacritty_sync_os_theme in zsh/profile) are
	# untouched. IPC overrides survive config reloads: a themed window stops
	# following OS light/dark switches until reset.
	function theme() {
		if [ -z "$ALACRITTY_WINDOW_ID" ]; then
			echo "theme: not running inside an alacritty window" >&2
			return 1
		fi
		local dir="$HOME/.config/alacritty/themes"
		local reset='(reset to global theme)'
		local current="$_ALACRITTY_WINDOW_THEME"
		local choice
		choice=$( (echo "$reset"; command ls "$dir" | sed 's/\.toml$//') | fzf \
        --print-query --ansi --reverse \
        --border --height=80% \
        --header="window theme" \
        --preview="fastfetch --pipe false -s colors -l apple" \
			  --bind "focus:execute-silent([ {} = \"$reset\" ] && alacritty msg config -r || alacritty msg config \"\$(cat $dir/{}.toml)\")")

		if [ "$choice" = "$reset" ]; then
			alacritty msg config -r
			_ALACRITTY_WINDOW_THEME=""
		elif [ -n "$choice" ]; then
			alacritty msg config "$(command cat "$dir/$choice.toml")"
			_ALACRITTY_WINDOW_THEME="$choice"
		elif [ -n "$current" ]; then
			# aborted: restore the previous per-window pick
			alacritty msg config "$(command cat "$dir/$current.toml")"
		else
			# aborted: drop whatever the preview applied
			alacritty msg config -r
		fi
	}
fi

if which bat &>/dev/null; then
	alias cat='bat -p --paging=never'
	function bat_in_language() {
		# if a language and file are passed, run bat with the language
		# eq "b sh .bashrc"
		# otherwise, just run bat
		if [ $# -eq 2 ]; then
			bat --language "$1" "$2"
		else
			bat "$1"
		fi
	}
	alias b='bat_in_language' # Usage: cat output | b json -
fi

if which cargo &>/dev/null; then
	alias cargo-watch='cargo watch -q -c -w src/ -x run'
fi

if which eza &>/dev/null; then
	alias ls='eza -la --group-directories-last'
	function tree() {
		# $1 depth # $2 path
		if [ $# -eq 2 ]; then
			eza -TL "$1" "$2"
		elif [ $# -eq 1 ]; then
			eza -TL 2 "$1"
		else
			eza -TL 2
		fi
	}
fi

if which fd &>/dev/null; then
	alias fo='nvim $(fd --type file | fzf)'
fi

if which fastfetch &>/dev/null; then
  alias ff='fastfetch'
fi

# `branches` (fzf checkout) lives in scripts/worktrees.sh alongside gct/wt

if which just &>/dev/null; then
	alias j='just'
	alias jsut='just'
fi

if which nerdctl &>/dev/null; then
	alias docker='nerdctl'
  alias n='nerdctl'
fi

if which nvim &>/dev/null; then
	export EDITOR='nvim'
	export VISUAL='nvim'

	alias vim='nvim'
	if [ ! -d ~/.config/nvim ]; then
		ln -s ~/.files/nvim ~/.config/nvim
	fi
fi

if which pipes.sh &>/dev/null; then
	alias pipes='pipes.sh'
fi

if which pipes-rs &>/dev/null; then
	alias pipes='pipes-rs'
fi

if which rg &>/dev/null; then
	alias grep='rg'
fi

if which virsh &>/dev/null; then
	export LIBVIRT_DEFAULT_URI=qemu:///system
	alias v='virsh'
	alias vrsh='virsh'
	alias libvirt-hooks='cd /etc/libvirt/hooks/qemu.d'
	alias libvirt-images='cd /var/lib/libvirt/images'
fi

if which buildctl &>/dev/null; then
  alias buildctl='buildctl --addr unix:///run/user/1000/buildkit/buildkitd.sock'
fi

