# Example secrets file for a NEW NixOS k3s VM.
# PLAINTEXT TEMPLATE — never commit real values in the clear.
#
# The `.yaml.example` suffix keeps this out of .sops.yaml's `secrets/.*\.yaml$`
# creation rule, so sops won't treat it as an encrypted file. Copy it to
# secrets/<hostname>.yaml, fill in real values, then encrypt in place with sops.
# The encrypted file is what the host reads at activation.
#
# ── One-time setup for a new host ─────────────────────────────────────────────
# 1. Get the host's age recipient. Two options:
#    a) Derive from the VM's SSH host key (recommended for headless VMs):
#         nix run nixpkgs#ssh-to-age -- -i /etc/ssh/ssh_host_ed25519_key.pub
#       then in the host's secrets module:
#         sops.age.sshKeyPaths = [ "/etc/ssh/ssh_host_ed25519_key" ];
#    b) Generate a standalone age key (as zenbook does) and place it at
#         /home/<user>/.config/sops/age/keys.txt
#       using its `age1...` public part as the recipient.
#
# 2. Add a creation rule in .sops.yaml so this file encrypts to that recipient:
#         - path_regex: secrets/<hostname>\.yaml$
#           age: age1<the-host-recipient>
#
# 3. Encrypt in place:   sops -e -i secrets/<hostname>.yaml
#
# 4. Point the host at it via a per-host secrets module, e.g.
#    hosts/<hostname>/secrets.nix (see hosts/staging-k3s/secrets.nix):
#         sops.defaultSopsFile = ../../secrets/<hostname>.yaml;
#         sops.age.sshKeyPaths = [ "/etc/ssh/ssh_host_ed25519_key" ];
# ──────────────────────────────────────────────────────────────────────────────

# Cluster join token for this node's k3s server. Generate a FRESH one — do not
# reuse zenbook's. Any high-entropy string works, e.g. `openssl rand -hex 32`.
k3s-token: REPLACE_WITH_openssl_rand_hex_32

# ── Optional: only needed if the host also imports the matching module ────────
# wireguard-private-key: REPLACE_WITH_wg_genkey        # modules/wireguard.nix
# restic-password: REPLACE_WITH_restic_repo_password   # modules/k3s-backup.nix
# restic-s3-env-<target>: |                            # modules/k3s-backup.nix
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
